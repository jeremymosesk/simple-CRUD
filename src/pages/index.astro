---
import WeddingInvitation from '../components/wedding/WeddingInvitation.vue';
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Jeremy & Sylvania Wedding Invitation</title>
    <meta name="description" content="Undangan pernikahan Jeremy & Sylvania - 27 Februari 2027" />
    <script type="module" src="https://unpkg.com/@google/model-viewer/dist/model-viewer.min.js"></script>
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      :root {
        color-scheme: dark;
      }

      body {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        min-height: 100vh;
        background: radial-gradient(circle at top, #4f2f1f 0%, #1a0f09 60%, #100803 100%);
        color: #f8ebd5;
        padding: 2rem 1rem;
      }

      main {
        width: min(1120px, 100%);
        margin: 0 auto;
      }
    </style>
  </head>
  <body>
    <main>
      <WeddingInvitation client:load />
    </main>
  </body>
</html>
